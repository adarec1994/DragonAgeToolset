            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Float%20keyword"><span class="kw2">float</span></a> fHeal <span class="sy0">=</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetCreatureProperty"><span class="kw4">GetCreatureProperty</span></a><span class="br0">&#40;</span>stEvent.<span class="me1">oTarget</span>,<span class="nu0">7</span>,<span class="kw3">PROPERTY_VALUE_TOTAL</span><span class="br0">&#41;</span>;
