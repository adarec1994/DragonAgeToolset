           <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a> <span class="br0">&#40;</span>stAttack1.<span class="me1">nAttackResult</span> <span class="sy0">!=</span> <span class="kw3">COMBAT_RESULT_DEATHBLOW</span> <span class="sy0">&amp;&amp;</span>  stAttack2.<span class="me1">nAttackResult</span> <span class="sy0">==</span> <span class="kw3">COMBAT_RESULT_DEATHBLOW</span><span class="br0">&#41;</span>
