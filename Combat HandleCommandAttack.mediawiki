&#160;
&#160;
        WR_AddCommand<span class="br0">&#40;</span>oAttacker, <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/CommandDeathBlow"><span class="kw4">CommandDeathBlow</span></a><span class="br0">&#40;</span>oTarget, stAttack1.<span class="me1">nDeathblowType</span><span class="br0">&#41;</span>, TRUE, TRUE<span class="br0">&#41;</span>;
