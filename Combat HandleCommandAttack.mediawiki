&#160;
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a> <span class="br0">&#40;</span>nHand <span class="sy0">==</span> HAND_MAIN<span class="br0">&#41;</span>
