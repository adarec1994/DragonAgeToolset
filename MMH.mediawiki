		SplatEmitter="int" -- true/false&#160;?? might be index of a SplatEmitter if they exist
		TargetAttraction="decimal"&gt;
		TargetName="?string?" 
		TargetRadius="decimal"
		UVDistributionSize="int"&gt;
		UseVariationTint="int" -- true/false&#160;??
