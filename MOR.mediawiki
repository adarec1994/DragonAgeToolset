<p>Facial Morph File 
</p>
<h2><span class="mw-headline" id="mor.xml">mor.xml</span></h2>
<p>See <a rel="nofollow" class="external autonumber" href="http://www.oasis-open.org/committees/relax-ng/spec.html">[1]</a> for information on the RELAX NG 1.0 XML schema format. For a free converter/verifier, see <a rel="nofollow" class="external autonumber" href="http://code.google.com/p/jing-trang/">[2]</a>.
</p>
<pre>
&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;grammar ns="" xmlns="http://relaxng.org/ns/structure/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"&gt;
  &lt;start&gt;
    &lt;element name="Morph"&gt;
      &lt;attribute name="Name"&gt;
        &lt;data type="NCName"/&gt;
      &lt;/attribute&gt;
      &lt;oneOrMore&gt;
        &lt;element name="Part"&gt;
          &lt;attribute name="Name"/&gt;
        &lt;/element&gt;
      &lt;/oneOrMore&gt;
      &lt;zeroOrMore&gt;
        &lt;element name="TintFile"&gt;
          &lt;attribute name="Name"/&gt;
        &lt;/element&gt;
      &lt;/zeroOrMore&gt;
      &lt;oneOrMore&gt;
        &lt;element name="MeshHierarchy"&gt;
          &lt;attribute name="Name"&gt;
            &lt;data type="NCName"/&gt;
          &lt;/attribute&gt;
          &lt;optional&gt;
            &lt;element name="Translation"&gt;
              &lt;text/&gt;
            &lt;/element&gt;
          &lt;/optional&gt;
          &lt;optional&gt;
            &lt;element name="Data"&gt;
              &lt;attribute name="ElementCount"&gt;
                &lt;data type="integer"/&gt;
              &lt;/attribute&gt;
              &lt;attribute name="Semantic"&gt;
                &lt;data type="NCName"/&gt;
              &lt;/attribute&gt;
              &lt;attribute name="Type"&gt;
                &lt;data type="NCName"/&gt;
              &lt;/attribute&gt;
              &lt;text/&gt;
            &lt;/element&gt;
          &lt;/optional&gt;
          &lt;optional&gt;
            &lt;choice&gt;
              &lt;element name="MaterialObjectInstanceParameters"&gt;
                &lt;zeroOrMore&gt;
                  &lt;ref name="float"/&gt;
                &lt;/zeroOrMore&gt;
                &lt;ref name="vector4f"/&gt;
              &lt;/element&gt;
              &lt;element name="MaterialObjectParameters"&gt;
                &lt;zeroOrMore&gt;
                  &lt;ref name="float"/&gt;
                &lt;/zeroOrMore&gt;
                &lt;oneOrMore&gt;
                  &lt;choice&gt;
                    &lt;ref name="vector4f"/&gt;
                    &lt;element name="texture"&gt;
                      &lt;attribute name="Name"&gt;
                        &lt;data type="NCName"/&gt;
                      &lt;/attribute&gt;
                      &lt;attribute name="ResName"&gt;
                        &lt;data type="NCName"/&gt;
                      &lt;/attribute&gt;
                    &lt;/element&gt;
                    &lt;element name="vector4farray"&gt;
                      &lt;attribute name="Name"&gt;
                        &lt;data type="NCName"/&gt;
                      &lt;/attribute&gt;
                      &lt;attribute name="value"/&gt;
                    &lt;/element&gt;
                  &lt;/choice&gt;
                &lt;/oneOrMore&gt;
              &lt;/element&gt;
            &lt;/choice&gt;
          &lt;/optional&gt;
        &lt;/element&gt;
      &lt;/oneOrMore&gt;
    &lt;/element&gt;
  &lt;/start&gt;
  &lt;define name="float"&gt;
    &lt;element name="float"&gt;
      &lt;attribute name="Name"&gt;
        &lt;data type="NCName"/&gt;
      &lt;/attribute&gt;
      &lt;attribute name="value"&gt;
        &lt;data type="integer"/&gt;
      &lt;/attribute&gt;
    &lt;/element&gt;
  &lt;/define&gt;
  &lt;define name="vector4f"&gt;
    &lt;element name="vector4f"&gt;
      &lt;attribute name="Name"&gt;
        &lt;data type="NCName"/&gt;
      &lt;/attribute&gt;
      &lt;attribute name="value"/&gt;
    &lt;/element&gt;
  &lt;/define&gt;
&lt;/grammar&gt;
</pre>
