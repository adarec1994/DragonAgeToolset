        <span class="co2">#endif</span>
        nAttackResult <span class="sy0">=</span> <span class="kw3">COMBAT_RESULT_MISS</span>;
    <span class="br0">&#125;</span>
&#160;
&#160;
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a> <span class="br0">&#40;</span>nAttackResult <span class="sy0">!=</span> <span class="kw3">COMBAT_RESULT_MISS</span><span class="br0">&#41;</span>
    <span class="br0">&#123;</span>
        <span class="co1">// -------------------------------------------------------------</span>
        <span class="co1">// Tell the damage effect to update gore and by how much...</span>
        <span class="co1">// see gore_h for details or ask georg.</span>
        <span class="co1">// -------------------------------------------------------------</span>
        <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Object%20keyword"><span class="kw2">object</span></a> oWeapon <span class="sy0">=</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetEffectObject"><span class="kw4">GetEffectObject</span></a><span class="br0">&#40;</span>eImpactEffect,<span class="nu0">0</span><span class="br0">&#41;</span>;
        <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a> nApp <span class="sy0">=</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetAppearanceType"><span class="kw4">GetAppearanceType</span></a><span class="br0">&#40;</span>oAttacker<span class="br0">&#41;</span>;
        <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a> nAbility <span class="sy0">=</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetEffectInteger"><span class="kw4">GetEffectInteger</span></a><span class="br0">&#40;</span>eImpactEffect,<span class="nu0">1</span><span class="br0">&#41;</span>;
&#160;
        <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Float%20keyword"><span class="kw2">float</span></a> fPerSpace <span class="sy0">=</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetM2DAFloat"><span class="kw4">GetM2DAFloat</span></a><span class="br0">&#40;</span>TABLE_APPEARANCE, <span class="st0">&quot;PERSPACE&quot;</span>, nApp<span class="br0">&#41;</span>;
        <span class="co1">// Skipping range check if the creature is large (personal space greater or equal to one)</span>
        <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a> <span class="br0">&#40;</span><a href="https://github.com/adarec1994/DragonAgeToolset/wiki/IsObjectValid"><span class="kw4">IsObjectValid</span></a><span class="br0">&#40;</span>oWeapon<span class="br0">&#41;</span> <span class="sy0">&amp;&amp;</span> IsUsingMeleeWeapon<span class="br0">&#40;</span>oAttacker, oWeapon<span class="br0">&#41;</span> <span class="sy0">&amp;&amp;</span> fPerSpace <span class="sy0">&lt;</span> <span class="nu0">1.0</span><span class="br0">&#41;</span>
        <span class="br0">&#123;</span>
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a> <span class="br0">&#40;</span><a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetDistanceBetween"><span class="kw4">GetDistanceBetween</span></a><span class="br0">&#40;</span>oTarget, oAttacker<span class="br0">&#41;</span> <span class="sy0">&gt;</span> <span class="nu0">5.0f</span><span class="br0">&#41;</span>
            <span class="br0">&#123;</span>
                <span class="co2">#ifdef DEBUG</span>
