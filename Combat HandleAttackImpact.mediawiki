                <span class="co2">#endif</span>
                nAttackResult <span class="sy0">=</span> <span class="kw3">COMBAT_RESULT_MISS</span>;
            <span class="br0">&#125;</span>
&#160;
        <span class="br0">&#125;</span>
&#160;
&#160;
    <span class="co1">// -----------------------------------------------------------------</span>
    <span class="co1">// The attack was successful, ...</span>
    <span class="co1">// -----------------------------------------------------------------</span>
       <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Float%20keyword"><span class="kw2">float</span></a> fDamage <span class="sy0">=</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetEffectFloat"><span class="kw4">GetEffectFloat</span></a><span class="br0">&#40;</span>eImpactEffect,<span class="nu0">0</span><span class="br0">&#41;</span>;
