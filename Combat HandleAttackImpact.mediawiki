<span class="br0">&#123;</span>
&#160;
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a> nUIMessage <span class="sy0">=</span> UI_MESSAGE_MISSED;
&#160;
    <span class="co1">// -------------------------------------------------------------------------</span>
    <span class="co1">// We retired combat result blocked, so we treat it as a miss here.</span>
    <span class="co1">// Might be back in DA2</span>
