<td style="background-color:#ffffff; border:1px solid #d4d0c8; vertical-align:top"> Roll Orientation</td>
<td> </td>
</tr>
<tr>
<td style="background-color:#d4d0c8; border:1px solid #d4d0c8;"> </td>
<td style="background-color:#ffffff; border:1px solid #d4d0c8; vertical-align:top"> Spawn Orientation</td>
<td> </td>
</tr>

</table>
