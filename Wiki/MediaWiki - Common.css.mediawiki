  <span class="kw1">background</span><span class="sy0">:</span> <span class="re0">#F2F2F2</span><span class="sy0">;</span>
  <span class="kw1">text-align</span><span class="sy0">:</span> <span class="kw2">center</span><span class="sy0">;</span>
<span class="br0">&#125;</span>
&nbsp;
<span class="re1">.wikitable</span> <span class="kw2">caption</span><span class="sy0">,</span>
