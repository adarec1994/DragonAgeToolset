&nbsp;
<span class="kw1">var</span> hasClass <span class="sy0">=</span> <span class="br0">&#40;</span><span class="kw1">function</span><span class="br0">&#40;</span><span class="br0">&#41;</span> <span class="br0">&#123;</span>
	<span class="kw1">var</span> reCache <span class="sy0">=</span> <span class="br0">&#123;</span><span class="br0">&#125;</span><span class="sy0">;</span>
	<span class="kw1">return</span> <span class="kw1">function</span><span class="br0">&#40;</span> element<span class="sy0">,</span> className <span class="br0">&#41;</span> <span class="br0">&#123;</span>
		<span class="kw1">return</span> <span class="br0">&#40;</span>reCache<span class="br0">&#91;</span>className<span class="br0">&#93;</span> <span class="sy0">?</span> reCache<span class="br0">&#91;</span>className<span class="br0">&#93;</span> <span class="sy0">:</span> <span class="br0">&#40;</span>reCache<span class="br0">&#91;</span>className<span class="br0">&#93;</span> <span class="sy0">=</span> <span class="kw1">new</span> RegExp<span class="br0">&#40;</span><span class="st0">&quot;(?:<span class="es0">\\</span>s|^)&quot;</span> <span class="sy0">+</span> className <span class="sy0">+</span> <span class="st0">&quot;(?:<span class="es0">\\</span>s|$)&quot;</span><span class="br0">&#41;</span><span class="br0">&#41;</span><span class="br0">&#41;</span>.<span class="me1">test</span><span class="br0">&#40;</span>element.<span class="me1">className</span><span class="br0">&#41;</span><span class="sy0">;</span>
