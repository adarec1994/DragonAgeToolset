                WR_SetPlotFlag<span class="br0">&#40;</span>PLT_VALERIA_FADE_NIGHTMARE,VALERIA_DEMON_KILLED,TRUE<span class="br0">&#41;</span>;
                oFollower <span class="sy0">=</span> Party_GetFollowerByTag<span class="br0">&#40;</span><span class="st0">&quot;valeria_npc&quot;</span><span class="br0">&#41;</span>;
                UT_Talk<span class="br0">&#40;</span>oFollower,oPC<span class="br0">&#41;</span>;
