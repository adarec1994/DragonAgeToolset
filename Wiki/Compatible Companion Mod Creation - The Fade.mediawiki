            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a>         bArcaneFormActive;
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a>         bBurningFormActive;
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a>         bGolemFormActive;
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a>         bMouseFormActive;
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a>         bSpiritFormActive;
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a>         bPCHasArcaneForm;
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a>         bPCHasBurningForm;
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a>         bPCHasGolemForm;
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a>         bPCHasMouseForm;
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a>         bPCHasSpiritForm;
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Object%20keyword"><span class="kw2">object</span></a> <span class="br0">&#91;</span><span class="br0">&#93;</span>   arFireBases, arSpiritBases;
&#160;
            nArraySize         <span class="sy0">=</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetArraySize"><span class="kw4">GetArraySize</span></a><span class="br0">&#40;</span> arFireBases <span class="br0">&#41;</span>;
            <span class="co1">// VALERIA'S NIGHTMARE</span>
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a>  <span class="br0">&#40;</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetTag"><span class="kw4">GetTag</span></a><span class="br0">&#40;</span>oThis<span class="br0">&#41;</span> <span class="sy0">==</span> <span class="st0">&quot;valeria_fade_nightmare&quot;</span> <span class="sy0">&amp;&amp;</span>  WR_GetPlotFlag<span class="br0">&#40;</span>PLT_VALERIA_FADE_NIGHTMARE,VALERIA_RETURNS_TO_PARTY<span class="br0">&#41;</span> <span class="sy0">==</span>  FALSE <span class="br0">&#41;</span>
            <span class="br0">&#123;</span>
                oFollower <span class="sy0">=</span> Party_GetFollowerByTag<span class="br0">&#40;</span><span class="st0">&quot;valeria_npc&quot;</span><span class="br0">&#41;</span>;
                WR_SetObjectActive<span class="br0">&#40;</span>oFollower, TRUE<span class="br0">&#41;</span>;
                UT_LocalJump<span class="br0">&#40;</span>oFollower,<span class="st0">&quot;valeria_spot&quot;</span><span class="br0">&#41;</span>;
<span class="co1">//this is the waypoint Valeria appears in the area, so move her there(see pictures)</span>
            <span class="br0">&#125;</span>
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Break%20keyword"><span class="kw1">break</span></a>;
        <span class="br0">&#125;</span>
&#160;
        <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Case%20keyword"><span class="kw1">case</span></a> EVENT_TYPE_TEAM_DESTROYED<span class="sy0">:</span>
        <span class="br0">&#123;</span>
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a> nTeamID <span class="sy0">=</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetEventInteger"><span class="kw4">GetEventInteger</span></a><span class="br0">&#40;</span>evEvent, <span class="nu0">0</span><span class="br0">&#41;</span>; <span class="co1">// Team ID</span>
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a><span class="br0">&#40;</span>nTeamID<span class="sy0">==</span><span class="nu0">19742</span><span class="br0">&#41;</span>
<span class="co1">//capture when the demon dies and talk to Valeria</span>
