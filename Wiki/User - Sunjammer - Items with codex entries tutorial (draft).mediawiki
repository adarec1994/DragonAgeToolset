<p>sp_module_item_acq:
</p>
<div dir="ltr" class="mw-geshi mw-code mw-content-ltr"><div class="dascript source-dascript"><pre class="de1">        <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Case%20keyword"><span class="kw1">case</span></a> EVENT_TYPE_CAMPAIGN_ITEM_ACQUIRED<span class="sy0">:</span>
        <span class="br0">&#123;</span>
            <span class="sy0">:</span>
&#160;
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Else%20keyword"><span class="kw1">else</span></a> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a><span class="br0">&#40;</span>sItemTag <span class="sy0">==</span> <span class="st0">&quot;gen_im_acc_rng_bld&quot;</span><span class="br0">&#41;</span>
            <span class="br0">&#123;</span>
