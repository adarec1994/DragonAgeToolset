            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Else%20keyword"><span class="kw1">else</span></a> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a><span class="br0">&#40;</span>sItemTag <span class="sy0">==</span> <span class="st0">&quot;gen_im_wep_rng_lbw_sun&quot;</span><span class="br0">&#41;</span>
            <span class="br0">&#123;</span>
                WR_SetPlotFlag<span class="br0">&#40;</span>PLT_COD_ITM_BOW_GOLDEN_SUN, COD_ITM_BOW_GOLDEN_SUN, TRUE, TRUE<span class="br0">&#41;</span>;
            <span class="br0">&#125;</span>
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Else%20keyword"><span class="kw1">else</span></a> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a><span class="br0">&#40;</span>sItemTag <span class="sy0">==</span> <span class="st0">&quot;gen_im_acc_amu_am6&quot;</span><span class="br0">&#41;</span>
            <span class="br0">&#123;</span>
                WR_SetPlotFlag<span class="br0">&#40;</span>PLT_COD_ITM_LIFE_DRINKER, COD_ITM_LIFE_DRINKER, TRUE, TRUE<span class="br0">&#41;</span>;
