                <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a><span class="br0">&#40;</span><a href="https://github.com/adarec1994/DragonAgeToolset/wiki/IsFollower"><span class="kw4">IsFollower</span></a><span class="br0">&#40;</span>oAcquirer<span class="br0">&#41;</span><span class="br0">&#41;</span>
                <span class="br0">&#123;</span>
                    <span class="co1">// Is the item one of ours? Other items can satify the first two conditions but</span>
                    <span class="co1">// will be handled by their author's code therefore we must ensure it is ours.</span>
                    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a><span class="br0">&#40;</span>sItem <span class="sy0">==</span> <span class="st0">&quot;xx_codex_itm_longsword&quot;</span><span class="br0">&#41;</span>
                    <span class="br0">&#123;</span>
                        <span class="co1">// Trigger the standard codex tutorial (it only shows once).</span>
