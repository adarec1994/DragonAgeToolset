    Log_Trace<span class="br0">&#40;</span><span class="kw3">LOG_CHANNEL_EVENTS_CHARGEN</span>,<span class="st0">&quot;bdm_sys_chargen&quot;</span>,<span class="st0">&quot;Chargen Event:&quot;</span> <span class="sy0">+</span> Log_GetEventNameById <span class="br0">&#40;</span>nEventType<span class="br0">&#41;</span> 
               <span class="sy0">+</span> <span class="st0">&quot; &quot;</span> <span class="sy0">+</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/ToString"><span class="kw4">ToString</span></a><span class="br0">&#40;</span>nInt0<span class="br0">&#41;</span> <span class="sy0">+</span> <span class="st0">&quot;,&quot;</span> <span class="sy0">+</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/ToString"><span class="kw4">ToString</span></a><span class="br0">&#40;</span>nInt1<span class="br0">&#41;</span>, oChar<span class="br0">&#41;</span>;
