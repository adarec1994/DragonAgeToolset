&#160;
                    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a><span class="br0">&#40;</span>nRandClass <span class="sy0">==</span> CLASS_ROGUE <span class="sy0">||</span> nRandClass <span class="sy0">==</span> CLASS_WARRIOR<span class="br0">&#41;</span>
                    <span class="br0">&#123;</span>
                        _RunChargen<span class="br0">&#40;</span>RACE_HUMAN, nRandClass, oChar, BACKGROUND_SERVANT <span class="br0">&#41;</span>;
