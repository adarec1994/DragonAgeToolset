              <span class="co1">// end</span>
&#160;
&#160;
<span class="co1">//How it has to look like</span>
&#160;
<a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Case%20keyword"><span class="kw1">case</span></a> EVENT_TYPE_CAMPAIGN_ITEM_ACQUIRED<span class="sy0">:</span>
        <span class="br0">&#123;</span>
