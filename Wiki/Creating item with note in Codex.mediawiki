                <span class="br0">&#123;</span>
                    WR_SetPlotFlag<span class="br0">&#40;</span>PLT_COD_ITEM_BLDVAL, COD_ITEM_BLDVAL, TRUE, TRUE<span class="br0">&#41;</span>; 
