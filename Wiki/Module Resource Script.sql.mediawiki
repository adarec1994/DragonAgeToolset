select * from dbo.t_AreaObjectGeometry as t, dbo.t_ModuleResRefVersion as m where t.ModuleResRefVersionID = m.ID and (m.ModuleID = @modID or m.OwnerModuleID = @modID)
select * from dbo.t_AreaObject as t, dbo.t_ModuleResRefVersion as m where t.ModuleResRefVersionID = m.ID and (m.ModuleID = @modID or m.OwnerModuleID = @modID)
select * from dbo.t_AreaMusicVolumeGeometry as t, dbo.t_ModuleResRefVersion as m where t.ModuleResRefVersionID = m.ID and (m.ModuleID = @modID or m.OwnerModuleID = @modID)
select * from dbo.t_AreaMusicVolume as t, dbo.t_ModuleResRefVersion as m where t.ModuleResRefVersionID = m.ID and (m.ModuleID = @modID or m.OwnerModuleID = @modID)
