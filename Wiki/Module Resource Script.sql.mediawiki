select * from dbo.t_Character as t, dbo.t_ModuleResRefVersion as m where t.ModuleResRefVersionID = m.ID and (m.ModuleID = @modID or m.OwnerModuleID = @modID)
select * from dbo.t_ConversationTransition as t, dbo.t_ModuleResRefVersion as m where t.ModuleResRefVersionID = m.ID and (m.ModuleID = @modID or m.OwnerModuleID = @modID)
