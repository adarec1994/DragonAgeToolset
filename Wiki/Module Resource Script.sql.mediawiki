-- resource refs
select * from dbo.t_ResRef as t, dbo.t_ModuleResRef as m where t.ID = m.ResRefId and m.ModuleID = @modID

-- tables using ModuleID (ModuleID = t_Module.ID)
select * from dbo.t_ModuleVariable as t where t.ModuleID = @modID
select * from dbo.t_ModuleResRef as t where t.ModuleID = @modID
select * from dbo.t_ModuleResRefVersion as t where t.ModuleID = @modID or t.OwnerModuleID = @modID

-- module tables
select * from dbo.t_ModuleAssociation as t where t.ChildModuleID = @modID or t.ParentModuleID = @modID
select * from dbo.t_String as t, dbo.t_Module as m where t.StringTableID = m.StringTableID and m.ID = @modID
select * from dbo.t_StringTable as t, dbo.t_Module as m where t.ID = m.StringTableID and m.ID = @modID
select * from dbo.t_Module as t where t.ID = @modID
</pre>
<p>You could also use this script to delete a module completely from the DB by changing all of the "select * from dbo.t_table" statements to "delete dbo.t_table from dbo.t_table". Use this is at your own risk, however, as it is not fully tested. It's probably a good idea to back up your DB before trying that. Also, you'll need to add a line near the beginning to null out some of the module scripts to avoid foreign key issues:
</p>
<pre>update dbo.t_Module set StartAreaResRefID = NULL, ScriptResRefID = NULL, ClientScriptResRefID = NULL where ID = @modID</pre>
