&#160;
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a> <span class="br0">&#40;</span><a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetBaseItemType"><span class="kw4">GetBaseItemType</span></a><span class="br0">&#40;</span>oWeapon<span class="br0">&#41;</span> <span class="sy0">==</span> BASE_ITEM_TYPE_STAFF<span class="br0">&#41;</span>
    <span class="br0">&#123;</span>
