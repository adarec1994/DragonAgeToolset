            <span class="co1">// ---------------------------------------------------------------------</span>
            <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a> <span class="br0">&#40;</span><a href="https://github.com/adarec1994/DragonAgeToolset/wiki/IsModalAbilityActive"><span class="kw4">IsModalAbilityActive</span></a><span class="br0">&#40;</span>oAttacker, ABILITY_SKILL_STEALTH_1<span class="br0">&#41;</span><span class="br0">&#41;</span>
            <span class="br0">&#123;</span>
