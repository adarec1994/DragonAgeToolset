    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a> <span class="br0">&#40;</span>fFlanking <span class="sy0">&gt;</span> <span class="nu0">0.0</span> <span class="br0">&#41;</span>
