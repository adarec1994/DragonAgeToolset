&#160;
        <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a> bThreatenCritical <span class="sy0">=</span> <span class="br0">&#40;</span><a href="https://github.com/adarec1994/DragonAgeToolset/wiki/RandomFloat"><span class="kw4">RandomFloat</span></a><span class="br0">&#40;</span><span class="br0">&#41;</span><span class="sy0">*</span><span class="nu0">100.0f</span>   <span class="sy0">&lt;</span> fCriticalHitModifier  <span class="br0">&#41;</span>;
&#160;
        <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a> <span class="br0">&#40;</span><span class="sy0">!</span>bThreatenCritical<span class="br0">&#41;</span>
        <span class="br0">&#123;</span>
            <span class="co1">// ---------------------------------------------------------------------</span>
