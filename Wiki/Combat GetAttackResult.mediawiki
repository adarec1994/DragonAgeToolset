    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a>  nAttackType <span class="sy0">=</span> Combat_GetAttackType<span class="br0">&#40;</span>oAttacker, oWeapon<span class="br0">&#41;</span>;
