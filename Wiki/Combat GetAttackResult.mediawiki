    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Float%20keyword"><span class="kw2">float</span></a> fNoPenaltyDistance <span class="sy0">=</span> MaxF<span class="br0">&#40;</span>POINT_BLANK_RANGE,<a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetItemStat"><span class="kw4">GetItemStat</span></a><span class="br0">&#40;</span>oWeapon, ITEM_STAT_OPTIMUM_RANGE<span class="br0">&#41;</span><span class="br0">&#41;</span>;
    fDistance <span class="sy0">=</span> MaxF<span class="br0">&#40;</span>fDistance<span class="sy0">-</span>fNoPenaltyDistance,<span class="nu0">0.0f</span><span class="br0">&#41;</span>;
