    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Float%20keyword"><span class="kw2">float</span></a> fRand <span class="sy0">=</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/RandomFloat"><span class="kw4">RandomFloat</span></a><span class="br0">&#40;</span><span class="br0">&#41;</span><span class="sy0">*</span><span class="nu0">100.0</span>;
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a> <span class="br0">&#40;</span> fRand <span class="sy0">&lt;</span> fDisplace<span class="br0">&#41;</span>
