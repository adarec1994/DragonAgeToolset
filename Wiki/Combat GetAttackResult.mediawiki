                <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a> nCmdType <span class="sy0">=</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetCommandType"><span class="kw4">GetCommandType</span></a><span class="br0">&#40;</span>currentCmd<span class="br0">&#41;</span>;
                <span class="co1">// Evasion only plays during attack and wait commands.</span>
                <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a> <span class="br0">&#40;</span> nCmdType <span class="sy0">==</span> <span class="kw3">COMMAND_TYPE_WAIT</span> <span class="sy0">||</span> nCmdType <span class="sy0">==</span> <span class="kw3">COMMAND_TYPE_ATTACK</span> <span class="sy0">||</span> nCmdType <span class="sy0">==</span> <span class="kw3">COMMAND_TYPE_INVALID</span> <span class="br0">&#41;</span>
