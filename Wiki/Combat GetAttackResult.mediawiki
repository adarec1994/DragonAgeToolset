&#160;
&#160;
&#160;
    fCriticalHitModifier <span class="sy0">=</span> GetCreatureCriticalHitModifier<span class="br0">&#40;</span>oAttacker, nCriticalHitModifier<span class="br0">&#41;</span>;
    fCriticalHitModifier <span class="sy0">+=</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetItemStat"><span class="kw4">GetItemStat</span></a><span class="br0">&#40;</span>oWeapon, ITEM_STAT_CRIT_CHANCE_MODIFIER<span class="br0">&#41;</span>;
