&#160;
  <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a> <span class="br0">&#40;</span><a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetObjectType"><span class="kw4">GetObjectType</span></a><span class="br0">&#40;</span>oSource<span class="br0">&#41;</span> <span class="sy0">==</span> <span class="kw3">OBJECT_TYPE_CREATURE</span><span class="br0">&#41;</span>
