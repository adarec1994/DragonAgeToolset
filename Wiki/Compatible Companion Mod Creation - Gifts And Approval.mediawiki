                <span class="sy0">||</span> sGiftTag<span class="sy0">==</span><span class="st0">&quot;valeria_gift5&quot;</span>  <span class="sy0">||</span> sGiftTag<span class="sy0">==</span><span class="st0">&quot;valeria_gift6&quot;</span><span class="br0">&#41;</span>
