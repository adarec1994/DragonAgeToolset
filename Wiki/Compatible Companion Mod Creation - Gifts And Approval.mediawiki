    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/PlaySoundSet"><span class="kw4">PlaySoundSet</span></a><span class="br0">&#40;</span>oFollower,nSoundSet<span class="br0">&#41;</span>;
    WR_DestroyObject<span class="br0">&#40;</span>oItem<span class="br0">&#41;</span>;
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/SetLocalInt"><span class="kw4">SetLocalInt</span></a><span class="br0">&#40;</span>thiefwrit1,ITEM_COUNTER_1,<a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetFollowerApproval"><span class="kw4">GetFollowerApproval</span></a><span class="br0">&#40;</span>oFollower<span class="br0">&#41;</span><span class="br0">&#41;</span>;
&#160;
<span class="co1">//if approval is 100 return everything</span>
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a><span class="br0">&#40;</span><a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetFollowerApproval"><span class="kw4">GetFollowerApproval</span></a><span class="br0">&#40;</span>oFollower<span class="br0">&#41;</span><span class="sy0">==</span><span class="nu0">100</span> <span class="sy0">&amp;&amp;</span> trueapproval<span class="sy0">==</span><span class="nu0">100</span><span class="br0">&#41;</span>
