    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Else%20keyword"><span class="kw1">else</span></a> nSoundSet<span class="sy0">=</span>SS_CHEER;
&#160;
    nApproval<span class="sy0">+=</span>nApprovalChange;
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a><span class="br0">&#40;</span>nApproval<span class="sy0">&lt;-</span><span class="nu0">100</span><span class="br0">&#41;</span>nApproval<span class="sy0">=-</span><span class="nu0">100</span>;
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a><span class="br0">&#40;</span>nApproval<span class="sy0">&gt;</span><span class="nu0">100</span><span class="br0">&#41;</span>nApproval<span class="sy0">=</span><span class="nu0">100</span>;
