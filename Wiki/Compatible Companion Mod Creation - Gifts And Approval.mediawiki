    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Object%20keyword"><span class="kw2">object</span></a> <span class="br0">&#91;</span><span class="br0">&#93;</span> thiefwrit<span class="sy0">=</span><a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetItemsInInventory"><span class="kw4">GetItemsInInventory</span></a><span class="br0">&#40;</span><a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetHero"><span class="kw4">GetHero</span></a><span class="br0">&#40;</span><span class="br0">&#41;</span>,<span class="kw3">GET_ITEMS_OPTION_BACKPACK</span>,<span class="nu0">0</span>,<span class="st0">&quot;valeria_thief_contract&quot;</span><span class="br0">&#41;</span>;
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Object%20keyword"><span class="kw2">object</span></a> thiefwrit1<span class="sy0">=</span>thiefwrit<span class="br0">&#91;</span><span class="nu0">0</span><span class="br0">&#93;</span>;
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Int%20keyword"><span class="kw2">int</span></a> trueapproval<span class="sy0">=</span><a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetLocalInt"><span class="kw4">GetLocalInt</span></a><span class="br0">&#40;</span>thiefwrit1,ITEM_COUNTER_1<span class="br0">&#41;</span>;
<span class="co1">//this checks to see if the current approval is not the true, which </span>
<span class="co1">//means the core game scripts have changed her approval, so bring it</span>
<span class="co1">//back to what it was. also if approval is 100 take care for a really </span>
<span class="co1">//nusty nusty nusty bug.</span>
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a><span class="br0">&#40;</span>nApproval<span class="sy0">!=</span>trueapproval<span class="br0">&#41;</span>
