<span class="br0">&#123;</span>
    <span class="co1">// uninitialised</span>
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/String%20keyword"><span class="kw2">string</span></a> sDefault;
&#160;
    <span class="co1">// initialised using &quot;forty two&quot; literal</span>
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/String%20keyword"><span class="kw2">string</span></a> sSpecific <span class="sy0">=</span> <span class="st0">&quot;forty two&quot;</span>;
&#160;
    <span class="co1">// initialised using concatenation</span>
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/String%20keyword"><span class="kw2">string</span></a> sConcatenated <span class="sy0">=</span> <span class="st0">&quot;Hello &quot;</span> <span class="sy0">+</span> <span class="st0">&quot;World&quot;</span>;
<span class="br0">&#125;</span></pre></div></div>
