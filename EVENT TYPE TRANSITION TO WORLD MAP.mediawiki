ning the map</span><br />    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/String%20keyword" title="String keyword">string</a> sWorldMapLoc3 = <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetEventString" title="GetEventString">GetEventString</a>(ev, <span style="color: #7F007F;">4</span>); <span style="color: #007F00; font-style: italic;">// the tag of a map location to activate right before opening the map</span><br />    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/String%20keyword" title="String keyword">string</a> sWorldMapLoc4 = <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetEventString" title="GetEventString">GetEventString</a>(ev, <span style="color: #7F007F;">5</span>); <span style="color: #007F00; font-style: italic;">// the tag of a map location to activate right before opening the map</span><br />    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/String%20keyword" title="String keyword">string</a> sWorldMapLoc5 = <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/GetEventString" title="GetEventString">GetEventString</a>(ev, <span style="color: #7F007F;">6</span>); <span style="color: #007F00; font-style: italic;">// the tag of a map location to activate right before opening the map</span><br /><br />    <span style="color:#007F00; font-style:italic;">// insert event-handling code here</span><br /><br />    <span style="color:#0000FF;"><a href="https://github.com/adarec1994/DragonAgeToolset/wiki/Break%20keyword" title="Break keyword (page does not exist)">break</a></span>;<br />}</div>
