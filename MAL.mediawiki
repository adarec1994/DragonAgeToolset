<p>Material Library file, Stores a grouping of material files.
</p>
<h2><span class="mw-headline" id="mal.xml">mal.xml</span></h2>
<p>See <a rel="nofollow" class="external autonumber" href="http://www.oasis-open.org/committees/relax-ng/spec.html">[1]</a> for information on the RELAX NG 1.0 XML schema format. For a free converter/verifier, see <a rel="nofollow" class="external autonumber" href="http://code.google.com/p/jing-trang/">[2]</a>.
</p>
<pre>
&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;grammar ns="" xmlns="http://relaxng.org/ns/structure/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"&gt;
  &lt;start&gt;
    &lt;element name="MaterialLibrary"&gt;
      &lt;optional&gt;
        &lt;attribute name="ID"&gt;
          &lt;data type="NCName"/&gt;
        &lt;/attribute&gt;
      &lt;/optional&gt;
      &lt;zeroOrMore&gt;
        &lt;element name="MaterialObject"&gt;
          &lt;attribute name="Name"&gt;
            &lt;data type="NMTOKEN"/&gt;
          &lt;/attribute&gt;
          &lt;zeroOrMore&gt;
            &lt;choice&gt;
              &lt;element name="DefaultSemantic"&gt;
                &lt;attribute name="Name"&gt;
                  &lt;data type="NCName"/&gt;
                &lt;/attribute&gt;
              &lt;/element&gt;
              &lt;element name="Float"&gt;
                &lt;attribute name="Name"&gt;
                  &lt;data type="NCName"/&gt;
                &lt;/attribute&gt;
                &lt;attribute name="value"&gt;
                  &lt;data type="decimal"/&gt;
                &lt;/attribute&gt;
              &lt;/element&gt;
              &lt;element name="Material"&gt;
                &lt;attribute name="Name"&gt;
                  &lt;data type="NCName"/&gt;
                &lt;/attribute&gt;
              &lt;/element&gt;
              &lt;element name="SoundType"&gt;
                &lt;attribute name="Name"&gt;
                  &lt;data type="NCName"/&gt;
                &lt;/attribute&gt;
                &lt;attribute name="value"&gt;
                  &lt;data type="integer"/&gt;
                &lt;/attribute&gt;
              &lt;/element&gt;
              &lt;element name="Texture"&gt;
                &lt;attribute name="Name"&gt;
                  &lt;data type="NCName"/&gt;
                &lt;/attribute&gt;
                &lt;optional&gt;
                  &lt;attribute name="RequiresID"&gt;
                    &lt;data type="boolean"/&gt;
                  &lt;/attribute&gt;
                &lt;/optional&gt;
                &lt;attribute name="ResName"/&gt;
              &lt;/element&gt;
              &lt;element name="Vector4f"&gt;
                &lt;attribute name="Name"&gt;
                  &lt;data type="NCName"/&gt;
                &lt;/attribute&gt;
                &lt;attribute name="value"/&gt;
              &lt;/element&gt;
              &lt;element name="float"&gt;
                &lt;attribute name="Name"&gt;
                  &lt;data type="NCName"/&gt;
                &lt;/attribute&gt;
                &lt;attribute name="value"&gt;
                  &lt;data type="decimal"/&gt;
                &lt;/attribute&gt;
              &lt;/element&gt;
              &lt;element name="texture"&gt;
                &lt;attribute name="Name"&gt;
                  &lt;data type="NCName"/&gt;
                &lt;/attribute&gt;
                &lt;attribute name="ResName"&gt;
                  &lt;data type="NCName"/&gt;
                &lt;/attribute&gt;
              &lt;/element&gt;
            &lt;/choice&gt;
          &lt;/zeroOrMore&gt;
        &lt;/element&gt;
      &lt;/zeroOrMore&gt;
    &lt;/element&gt;
  &lt;/start&gt;
&lt;/grammar&gt;
</pre>
