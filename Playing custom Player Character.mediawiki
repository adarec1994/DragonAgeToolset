    <span class="br0">&#125;</span>
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/If%20keyword"><span class="kw1">if</span></a><span class="br0">&#40;</span>GetLevel<span class="br0">&#40;</span>oPC<span class="br0">&#41;</span><span class="sy0">&gt;=</span><span class="nu0">14</span><span class="br0">&#41;</span>
        <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/SetCreatureProperty"><span class="kw4">SetCreatureProperty</span></a><span class="br0">&#40;</span>me, <span class="nu0">38</span>, count<span class="br0">&#41;</span>;  <span class="co1">// 38 is the spec point ID</span>
