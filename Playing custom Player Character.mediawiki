    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/SetLocalInt"><span class="kw4">SetLocalInt</span></a><span class="br0">&#40;</span>me, AI_FLAG_STATIONARY, <span class="nu0">0</span><span class="br0">&#41;</span>;
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/SetLocalInt"><span class="kw4">SetLocalInt</span></a><span class="br0">&#40;</span>me, AMBIENT_SYSTEM_STATE, <span class="nu0">0</span><span class="br0">&#41;</span>;
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/SetLocalInt"><span class="kw4">SetLocalInt</span></a><span class="br0">&#40;</span>me, CREATURE_REWARD_FLAGS, <span class="nu0">0</span><span class="br0">&#41;</span>;
&#160;
    <span class="co1">//change script to player and send hire event</span>
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/SetEventScript"><span class="kw4">SetEventScript</span></a><span class="br0">&#40;</span>me, RESOURCE_SCRIPT_PLAYER_CORE<span class="br0">&#41;</span>;
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/InitHeartbeat"><span class="kw4">InitHeartbeat</span></a><span class="br0">&#40;</span>me, CONFIG_CONSTANT_HEARTBEAT_RATE<span class="br0">&#41;</span>;
