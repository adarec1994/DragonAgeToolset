&#160;
    <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/PrintToLog"><span class="kw4">PrintToLog</span></a><span class="br0">&#40;</span><span class="st0">&quot;-----&gt; lop_ReHireFollower: Race: &quot;</span> <span class="sy0">+</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/IntToString"><span class="kw4">IntToString</span></a><span class="br0">&#40;</span>nRace<span class="br0">&#41;</span> <span class="sy0">+</span>
        <span class="st0">&quot;, Current Core Class: &quot;</span> <span class="sy0">+</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/IntToString"><span class="kw4">IntToString</span></a><span class="br0">&#40;</span>nClass<span class="br0">&#41;</span> <span class="sy0">+</span> <span class="st0">&quot;, Wanted Core Class: &quot;</span> <span class="sy0">+</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/IntToString"><span class="kw4">IntToString</span></a><span class="br0">&#40;</span>nCoreClass<span class="br0">&#41;</span> <span class="sy0">+</span>
        <span class="st0">&quot;, Gender: &quot;</span> <span class="sy0">+</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/IntToString"><span class="kw4">IntToString</span></a><span class="br0">&#40;</span>nGender<span class="br0">&#41;</span> <span class="sy0">+</span> <span class="st0">&quot;, Current (sub) Class: &quot;</span> <span class="sy0">+</span> <a href="https://github.com/adarec1994/DragonAgeToolset/wiki/IntToString"><span class="kw4">IntToString</span></a><span class="br0">&#40;</span>nCurrentClass<span class="br0">&#41;</span><span class="br0">&#41;</span>;
